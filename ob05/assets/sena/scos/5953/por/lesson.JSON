a": [{"contents": [{"type": "pdf", "content": "engenn7le02ob05re7pdf01.pdf"}], "type": "question"}], "responses": [{"correct": 1, "id": 0, "_data": [{"type": "text", "content": ""}], "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "DWS", "_data": [{"contents": [{"type": "text", "content": " Take a personality test on the internet and compare your results with a partner."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}], "type": "post_instructions"}], "id": 11}], "type": "scholar", "id": 0, "stimuli": [{"contents": [{}], "type": "welcome", "id": 0, "_data": [], "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"images": [{"text": "", "time": "0", "id": 0, "image": "engenn7le02ob05re2img01.jpg"}, {"text": "A personality profile is a tool used to evaluate a person's personal attributes, values and life skills. Originally, the goal of knowing a personality profile was to allow an employer to maximize an employee's job performance and contribution to the company.  Now, personality tests are something many people find fascinating. They are very popular. People must enjoy thinking about their personality, even though the results can be surprising or even shocking.", "time": "100", "id": 1, "image": "engenn7le02ob05re2img01.jpg"}, {"text": "Questions in a personality profile test are designed to seek out information about a person's decision-making methods, communication style and general attitude. The information is used to match the right employee to the right project or task.", "time": "33000", "id": 2, "image": "engenn7le02ob05re2img05.jpg"}, {"text": "The Myers-Briggs test separates people into 16 well-defined categories. In my opinion, that can't always be the case.  Are you excited about the idea of challenge? Do you feel annoyed when people disagree with you? If so, you must be the Executive type.  Are you worried about what people think? Do you find social situations frustrating? You must fall into the Artist type. Whatever you think about the results of your tests, it's entertaining to talk about personality.", "time": "48000", "id": 3, "image": "engenn7le02ob05re2img06.jpg"}], "audiosrc": "engenn7le02ob05re2aud01", "coverimg": "engenn7le02ob05re2img01.jpg"}}], "template_override": 1, "type": "audio", "_data": [], "id": 1, "title": ""}], "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}]}